generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MAHASISWA
  DOSEN
  TEKNISI
}

enum ItemCondition {
  GOOD
  DAMAGED
  MAINTENANCE
}

enum LoanStatus {
  PENDING
  APPROVED
  BORROWED
  RETURNED
  REJECTED
}

model User {
  id              Int      @id @default(autoincrement())
  identity_number String   @unique @db.VarChar(50)
  name            String   @db.VarChar(100)
  email           String   @unique @db.VarChar(255)
  password_hash   String
  role            UserRole
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  loans            Loan[] @relation("Borrower")
  maintained_items Item[] @relation("Maintainer")
  approved_loans   Loan[] @relation("Approver")

  @@map("users")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  items Item[]

  @@map("categories")
}

model Item {
  id                 Int           @id @default(autoincrement())
  category_id        Int
  maintainer_id      Int
  code               String        @unique @db.VarChar(50)
  name               String        @db.VarChar(150)
  description        String?
  quantity           Int           @default(0)
  available_quantity Int           @default(0)
  condition          ItemCondition @default(GOOD)
  is_active          Boolean       @default(true)
  created_at         DateTime      @default(now()) @db.Timestamptz(6)
  updated_at         DateTime      @default(now()) @db.Timestamptz(6)

  category   Category   @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  maintainer User       @relation("Maintainer", fields: [maintainer_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  loan_items LoanItem[]

  @@map("items")
}

model Loan {
  id                    Int        @id @default(autoincrement())
  user_id               Int
  status                LoanStatus @default(PENDING)
  requested_at          DateTime   @default(now()) @db.Timestamptz(6)
  approved_at           DateTime?  @db.Timestamptz(6)
  approved_by           Int?
  borrowed_at           DateTime?  @db.Timestamptz(6)
  due_date              DateTime?  @db.Date
  returned_at           DateTime?  @db.Timestamptz(6)
  identity_document_url String?
  notes                 String?
  rejection_reason      String?
  return_notes          String?
  created_at            DateTime   @default(now()) @db.Timestamptz(6)
  updated_at            DateTime   @default(now()) @db.Timestamptz(6)

  user       User       @relation("Borrower", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  approver   User?      @relation("Approver", fields: [approved_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  loan_items LoanItem[]

  @@map("loans")
}

model LoanItem {
  id       Int @id @default(autoincrement())
  loan_id  Int
  item_id  Int
  quantity Int

  loan Loan @relation(fields: [loan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  item Item @relation(fields: [item_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([loan_id, item_id])
  @@map("loan_items")
}
